# Central Backend API Endpoint
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Mock API Engine Toggle
# Set to 'true' to run fully self-contained offline & mock mode with zero external backend
# Set to 'false' to route HTTP requests directly to live REST server
VITE_ENABLE_MOCK_API=true

# Application Metadata
VITE_APP_NAME="CRY NGO360"
VITE_APP_VERSION="1.0.0"
